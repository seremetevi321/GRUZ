{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SafeDeal",
  "version": "0.1.0",
  "identifier": "ru.safedeal.escrow",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev -- --mode desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "customer", "title": "Заказчик — Безопасная сделка", "url": "index.html?as=alfa", "width": 1280, "height": 860, "x": 20, "y": 40 },
      { "label": "carrier", "title": "Перевозчик — Безопасная сделка", "url": "index.html?as=transline", "width": 1280, "height": 860, "x": 120, "y": 80 },
      { "label": "operator", "title": "Оператор банка — Безопасная сделка", "url": "index.html?as=operator", "width": 1280, "height": 860, "x": 220, "y": 120 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:8000; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
